static SmokeVol_WriteAsset(const String:path[], const data[], size)
{
	if (FileExists(path))
		return;

	new Handle:hFile = OpenFile(path, "wb");
	if (hFile == INVALID_HANDLE)
	{
		LogError("[SMAC] smokefix: could not write embedded asset %s", path);
		return;
	}

	for (new i = 0; i < size; i++)
		WriteFileCell(hFile, data[i], 1);

	CloseHandle(hFile);
}

// Writes the embedded smokefix assets to the game directory if missing.
// Total payload: 10145 bytes across 8 files.
stock SmokeVol_ExtractAssets()
{
	if (!DirExists("materials"))
		CreateDirectory("materials", 511);
	if (!DirExists("materials/rxg"))
		CreateDirectory("materials/rxg", 511);
	if (!DirExists("models"))
		CreateDirectory("models", 511);
	if (!DirExists("models/rxg"))
		CreateDirectory("models/rxg", 511);

	SmokeVol_WriteAsset("materials/rxg/smokevol.vmt", g_SmokeVolAsset_materials_rxg_smokevol_vmt, sizeof(g_SmokeVolAsset_materials_rxg_smokevol_vmt));
